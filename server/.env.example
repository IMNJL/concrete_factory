# Email settings (рекомендуется): Resend HTTP API
# Заполните и сохраните как server/.env
# ВАЖНО: не коммитьте server/.env в git.

# Порт сервера (по умолчанию 3002)
PORT=3002

# CORS (нужно, если фронтенд работает на другом домене, например GitHub Pages)
# Пример: https://imnjl.github.io
# Можно оставить пустым для '*'
CORS_ORIGIN=

# Провайдер отправки
EMAIL_PROVIDER=resend

# Ключ Resend (берётся в личном кабинете Resend)
RESEND_API_KEY=re_********************************

# Куда получать письма с сайта
TO_EMAIL=receiver@example.com

# От кого отправлять
# Для быстрого теста можно использовать: onboarding@resend.dev
# Для своего домена нужно верифицировать домен в Resend.
FROM_EMAIL=onboarding@resend.dev
FROM_NAME=Сайт БРУ Кременкуль

# ---------------------------
# Admin security (обязательно для админ-панели)
# ---------------------------
# Вариант 1 (проще): сильный пароль (16+ символов, верхний/нижний регистр, цифра и спецсимвол)
ADMIN_PASSWORD=PFi,o<7W%2vhitLk

# Вариант 2 (без хранения пароля в открытом виде): хэш PBKDF2
# Формат: pbkdf2$<iterations>$<saltHex>$<hashHex>
# Если указан ADMIN_PASSWORD_HASH, он имеет приоритет над ADMIN_PASSWORD.
# ADMIN_PASSWORD_HASH=

# Защита от brute-force
ADMIN_MAX_FAILS=5
ADMIN_FAIL_WINDOW_MINUTES=15
ADMIN_BLOCK_MINUTES=30
ADMIN_ALERT_THRESHOLD=3
ADMIN_ALERT_COOLDOWN_MINUTES=5
ADMIN_SESSION_TTL_HOURS=8
